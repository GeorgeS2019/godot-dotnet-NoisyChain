[configuration]

entry_symbol = "summator_library_init"
compatibility_minimum = 4.1
reloadable = false

[libraries]

linux.x86_64.single.debug = "res://lib/linux/Summator.so"
linux.x86_64.single.release = "res://lib/linux/Summator.so"
;linux.debug.arm64 = "res://lib/Summator.so"
;linux.release.arm64 = "res://lib/Summator.so"
windows.x86_64.single.debug = "res://lib/windows/Summator.dll"
windows.x86_64.single.release = "res://lib/windown/Summator.dll"
android.arm64.single.debug = "res://lib/android/Summator.so"
android.arm64.single.release = "res://lib/android/Summator.so"
;macos.debug = "res://lib/macosx/Summator.dylib"
;macos.release = "res://lib/macosx/Summator.dylib"
